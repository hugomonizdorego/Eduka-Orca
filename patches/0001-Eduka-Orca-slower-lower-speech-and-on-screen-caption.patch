+# Lesser General Public License for more details.
+
+"""Default values used by Eduka-Orca, the Orca build for Edukasaun OS (Eduka-Desktop).
+
+Eduka-Orca is tuned for people who are hard of hearing:
+
+* speech is slower than upstream Orca (rate 30 instead of 50, on a 0-100 scale), so that
+  words are not rushed together;
+* the voice is slightly lower (pitch 4.5 instead of 5.0); lower frequencies are usually
+  easier to hear for people with age-related or noise-induced hearing loss;
+* volume stays at the maximum;
+* everything Orca speaks is also shown as large, high-contrast captions in the
+  speech monitor window, which is enabled by default.
+
+Every value here is only a default: users can still change all of them in the Orca
+preferences, and administrators can override them with a GSettings override file.
+
+The GSettings schema defaults are written as literals in the @gsetting decorators
+(the schema generator only reads literals); tests/unit_tests/test_eduka_defaults.py
+checks that they stay in sync with the values below.
+"""
+
+from __future__ import annotations
+
+# Speech rate on Orca's 0-100 scale (upstream default: 50).
+# Speech-dispatcher receives 2 * rate - 100, so 30 becomes -40.
+DEFAULT_RATE: int = 30
+
+# Average pitch on Orca's 0.0-10.0 scale (upstream default: 5.0).
+DEFAULT_PITCH: float = 4.5
+
+# Volume on Orca's 0.0-10.0 scale (same as upstream: maximum).
+DEFAULT_VOLUME: float = 10.0
+
+# Speech monitor (on-screen captions of everything Orca says).
+MONITOR_ENABLED: bool = True
+MONITOR_FONT_SIZE: int = 24
+MONITOR_FOREGROUND: str = "#ffff00"
+MONITOR_BACKGROUND: str = "#000000"
+
+# Fraction of the screen height used by the caption window, which is docked at the
+# bottom of the screen like television subtitles.
+MONITOR_HEIGHT_FRACTION: float = 0.28
+
+# Languages without a speech-dispatcher / eSpeak NG voice, mapped to the closest voice.
+# Tetum (Timor-Leste) uses Portuguese-based spelling, so a European Portuguese voice
+# pronounces it far better than the English fallback speech-dispatcher would otherwise use.
+SPEECH_LANGUAGE_FALLBACKS: dict[str, tuple[str, str]] = {
+    "tet": ("pt", "PT"),
+}
+
+
+def map_speech_language(language: str, dialect: str) -> tuple[str, str]:
+    """Returns (language, dialect), replaced by a fallback voice language when needed."""
+
+    return SPEECH_LANGUAGE_FALLBACKS.get((language or "").lower(), (language, dialect))
