+"""Checks that Eduka-Orca's slow-speech and caption defaults are applied everywhere."""
+
+from __future__ import annotations
+
+import ast
+import importlib.util
+import subprocess
+import sys
+import xml.etree.ElementTree as ET
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+SRC = Path(__file__).resolve().parents[2] / "src" / "orca"
+TOOLS = Path(__file__).resolve().parents[2] / "tools"
+
+
+def _load_defaults() -> Any:
+    spec = importlib.util.spec_from_file_location("eduka_defaults", SRC / "eduka_defaults.py")
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+EDUKA = _load_defaults()
+
+
+def _decorator_default(filename: str, key_constant: str) -> Any:
+    """Returns the literal default= of the @gsetting decorator using key=<key_constant>."""
+
+    tree = ast.parse((SRC / filename).read_text())
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.FunctionDef):
+            continue
+        for decorator in node.decorator_list:
+            if not isinstance(decorator, ast.Call):
+                continue
+            keywords = {kw.arg: kw.value for kw in decorator.keywords}
+            key = keywords.get("key")
+            if isinstance(key, ast.Name) and key.id == key_constant and "default" in keywords:
+                return ast.literal_eval(keywords["default"])
+    raise AssertionError(f"No @gsetting with key={key_constant} in {filename}")
+
+
+@pytest.mark.unit
+@pytest.mark.parametrize(
+    ("filename", "key_constant", "expected"),
+    [
+        ("speech_manager.py", "KEY_RATE", EDUKA.DEFAULT_RATE),
+        ("speech_manager.py", "KEY_PITCH", EDUKA.DEFAULT_PITCH),
+        ("speech_manager.py", "KEY_VOLUME", EDUKA.DEFAULT_VOLUME),
+        ("speech_presenter.py", "KEY_MONITOR_ENABLED", EDUKA.MONITOR_ENABLED),
+        ("speech_presenter.py", "KEY_MONITOR_FONT_SIZE", EDUKA.MONITOR_FONT_SIZE),
+        ("speech_presenter.py", "KEY_MONITOR_FOREGROUND", EDUKA.MONITOR_FOREGROUND),
+        ("speech_presenter.py", "KEY_MONITOR_BACKGROUND", EDUKA.MONITOR_BACKGROUND),
+    ],
+)
+def test_schema_literals_match_eduka_defaults(filename: str, key_constant: str, expected: Any):
+    """The literal schema defaults must match eduka_defaults.py."""
+
+    assert _decorator_default(filename, key_constant) == expected
+
+
+@pytest.mark.unit
+def test_speech_is_slower_and_lower_than_upstream():
+    """Eduka-Orca must speak slower and slightly lower than upstream Orca (50 / 5.0)."""
+
+    assert 0 < EDUKA.DEFAULT_RATE < 50
+    assert 0.0 < EDUKA.DEFAULT_PITCH < 5.0
+    assert EDUKA.DEFAULT_VOLUME == 10.0
+    # Speech-dispatcher range is -100..100; make sure the result is still intelligible.
+    assert -60 <= 2 * EDUKA.DEFAULT_RATE - 100 < 0
+
+
+@pytest.mark.unit
+def test_no_upstream_rate_fallbacks_left():
+    """No runtime fallback should silently bring back the upstream rate of 50."""
+
+    for filename in ("speech_manager.py", "speech_presenter.py", "speechdispatcherfactory.py"):
+        text = (SRC / filename).read_text()
+        assert "ACSS.RATE, 50)" not in text, filename
+        assert "_set_rate(50" not in text, filename
+        assert '"rate", "i", 50' not in text, filename
+
+
+@pytest.mark.unit
+def test_generated_schema_contains_eduka_defaults(tmp_path: Path):
+    """The generated org.gnome.Orca schema must carry the Eduka defaults."""
+
+    output = tmp_path / "org.gnome.Orca.gschema.xml"
+    generator = TOOLS / "generate_gsettings_schemas.py"
+    subprocess.run([sys.executable, str(generator), str(SRC.parent), str(output)], check=True)
+    root = ET.parse(output).getroot()
+
+    def default_of(schema_id: str, key_name: str) -> str:
+        for schema in root.iter("schema"):
+            if schema.get("id") != schema_id:
+                continue
+            for key in schema.iter("key"):
+                if key.get("name") == key_name:
+                    return (key.findtext("default") or "").strip()
+        raise AssertionError(f"{schema_id}:{key_name} not in generated schema")
+
+    assert default_of("org.gnome.Orca.Voice", "rate") == str(EDUKA.DEFAULT_RATE)
+    assert float(default_of("org.gnome.Orca.Voice", "pitch")) == EDUKA.DEFAULT_PITCH
+    assert default_of("org.gnome.Orca.Speech", "monitor-enabled") == "true"
+    assert default_of("org.gnome.Orca.Speech", "monitor-font-size") == str(EDUKA.MONITOR_FONT_SIZE)
+
+
+@pytest.mark.unit
+@pytest.mark.parametrize(
+    ("language", "dialect", "expected"),
+    [
+        ("tet", "TL", ("pt", "PT")),
+        ("TET", "", ("pt", "PT")),
+        ("id", "ID", ("id", "ID")),
+        ("pt", "BR", ("pt", "BR")),
+        ("", "", ("", "")),
+    ],
+)
+def test_tetum_uses_portuguese_voice(language: str, dialect: str, expected: tuple[str, str]):
+    """Tetum has no eSpeak NG voice, so it must fall back to European Portuguese."""
+
+    assert EDUKA.map_speech_language(language, dialect) == expected
