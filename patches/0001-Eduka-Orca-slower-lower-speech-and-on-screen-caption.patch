@@ -99,6 +104,12 @@ class SpeechMonitor(Gtk.Window):  # pylint: disable=too-many-instance-attributes
         self._text_view.set_bottom_margin(6)
         self._buffer = self._text_view.get_buffer()
         self._end_mark = self._buffer.create_mark("end", self._buffer.get_end_iter(), False)
+        # Eduka-Orca: the newest caption is shown in bold so the eye can find what was
+        # just spoken at a glance.
+        self._latest_start = self._buffer.create_mark(
+            "latest-start", self._buffer.get_end_iter(), True
+        )
+        self._latest_tag = self._buffer.create_tag("eduka-latest", weight=700)
         self._line_count = 0
 
         scrolled = Gtk.ScrolledWindow()
@@ -131,10 +142,32 @@ class SpeechMonitor(Gtk.Window):  # pylint: disable=too-many-instance-attributes
         self.set_skip_pager_hint(True)
 
         self.set_focus(self._text_view)
+        self.connect("realize", self._on_realize)
         self.connect("notify::is-active", self._on_window_activated)
         self.connect("delete-event", self._on_delete_event)
         self.connect("key-press-event", self._on_key_press)
 
+    def _on_realize(self, _window: Gtk.Window) -> None:
+        """Dock the window along the bottom of the monitor, like television subtitles."""
+
+        # pylint: disable=no-member
+        try:
+            display = Gdk.Display.get_default()
+            gdk_window = self.get_window()
+            monitor = None
+            if display is not None:
+                monitor = display.get_monitor_at_window(gdk_window) if gdk_window else None
+                monitor = monitor or display.get_primary_monitor() or display.get_monitor(0)
+            if monitor is None:
+                return
+            area = monitor.get_workarea()
+            height = max(160, int(area.height * eduka_defaults.MONITOR_HEIGHT_FRACTION))
+            self.resize(area.width, height)
+            # Positioning is ignored on Wayland; there the compositor decides placement.
+            self.move(area.x, area.y + area.height - height)
+        except (AttributeError, TypeError):
+            pass
+
     def _on_window_activated(self, _window: Gtk.Window, _pspec: Any) -> None:
         """Grab focus on the text view whenever the window becomes active."""
 
@@ -236,7 +269,17 @@ class SpeechMonitor(Gtk.Window):  # pylint: disable=too-many-instance-attributes
     def _append_text(self, text: str) -> None:
         """Appends text, trims excess lines, and scrolls to the bottom."""
 
+        # Eduka-Orca: move the "latest" highlight to the new caption.
+        start = self._buffer.get_start_iter()
+        end = self._buffer.get_end_iter()
+        self._buffer.remove_tag(self._latest_tag, start, end)
+        self._buffer.move_mark(self._latest_start, end)
         self._buffer.insert(self._buffer.get_end_iter(), text)
+        self._buffer.apply_tag(
+            self._latest_tag,
+            self._buffer.get_iter_at_mark(self._latest_start),
+            self._buffer.get_end_iter(),
+        )
         self._line_count += text.count("\n")
         if self._line_count > 500:
             excess = self._line_count - 500
