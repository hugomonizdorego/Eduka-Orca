diff --git a/debian/rules b/debian/rules
new file mode 100755
index 0000000..e6ebfa8
--- /dev/null
+++ b/debian/rules
@@ -0,0 +1,23 @@
+#!/usr/bin/make -f
+# Eduka-Orca Debian packaging for Edukasaun OS (Debian 13 "trixie" based).
+
+export DEB_BUILD_MAINT_OPTIONS = hardening=+all
+
+%:
+	dh $@ --with python3 --buildsystem=meson
+
+override_dh_auto_configure:
+	dh_auto_configure -- \
+		-Dspiel=false \
+		-Dpython.purelibdir=/usr/lib/python3/dist-packages
+
+# Upstream's integration tests need a running desktop session; run the
+# Eduka checks (defaults, schema, Tetum voice mapping) instead.
+override_dh_auto_test:
+ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
+	python3 -m pytest -q -p no:cacheprovider --noconftest \
+		tests/unit_tests/test_eduka_defaults.py
+endif
+
+override_dh_python3:
+	dh_python3 --shebang=/usr/bin/python3
