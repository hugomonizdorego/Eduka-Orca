+@pytest.mark.unit
+def test_vendor_overridable_keys_exist(tmp_path: Path):
+    """Every key admins may override system-wide must exist in the generated schema."""
+
+    output = tmp_path / "org.gnome.Orca.gschema.xml"
+    generator = TOOLS / "generate_gsettings_schemas.py"
+    subprocess.run([sys.executable, str(generator), str(SRC.parent), str(output)], check=True)
+    root = ET.parse(output).getroot()
+    schema_ids = {"voice": "org.gnome.Orca.Voice", "speech": "org.gnome.Orca.Speech"}
+    keys = {
+        (schema.get("id"), key.get("name"))
+        for schema in root.iter("schema")
+        for key in schema.iter("key")
+    }
+    for schema, key in EDUKA.VENDOR_OVERRIDABLE_KEYS:
+        assert (schema_ids[schema], key) in keys, (schema, key)
