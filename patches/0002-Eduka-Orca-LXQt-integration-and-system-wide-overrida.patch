diff --git a/src/orca/eduka_defaults.py b/src/orca/eduka_defaults.py
index 55bc3b8..ba6e4cf 100644
--- a/src/orca/eduka_defaults.py
+++ b/src/orca/eduka_defaults.py
@@ -54,6 +54,21 @@ MONITOR_BACKGROUND: str = "#000000"
 # bottom of the screen like television subtitles.
 MONITOR_HEIGHT_FRACTION: float = 0.28
 
+# Settings for which Orca honours the GSettings schema default, so that distributions
+# and school administrators can tune them system-wide with a *.gschema.override file
+# instead of patching code. (Upstream Orca only reads values the user set in dconf.)
+VENDOR_OVERRIDABLE_KEYS: frozenset[tuple[str, str]] = frozenset(
+    {
+        ("voice", "rate"),
+        ("voice", "pitch"),
+        ("voice", "volume"),
+        ("speech", "monitor-enabled"),
+        ("speech", "monitor-font-size"),
+        ("speech", "monitor-foreground"),
+        ("speech", "monitor-background"),
+    }
+)
+
 # Languages without a speech-dispatcher / eSpeak NG voice, mapped to the closest voice.
 # Tetum (Timor-Leste) uses Portuguese-based spelling, so a European Portuguese voice
 # pronounces it far better than the English fallback speech-dispatcher would otherwise use.
diff --git a/src/orca/gsettings_registry.py b/src/orca/gsettings_registry.py
index fe1cc11..c264049 100644
--- a/src/orca/gsettings_registry.py
+++ b/src/orca/gsettings_registry.py
@@ -39,7 +39,7 @@ from typing import TYPE_CHECKING, Any, overload
 
 from gi.repository import Gio
 
-from . import debug, gsettings_migrator
+from . import debug, eduka_defaults, gsettings_migrator
 
 if TYPE_CHECKING:
     from collections.abc import Callable
@@ -182,8 +182,32 @@ class GSettingsRegistry:
         result = accessor(key, sub_path, effective_app) if accessor is not None else None
         if result is not None:
             return result
+        vendor = self._vendor_default(handle, schema, key)
+        if vendor is not None:
+            return vendor
         return self._use_default(schema, key, default)
 
+    @staticmethod
+    def _vendor_default(handle: GSettingsSchemaHandle, schema: str, key: str) -> Any | None:
+        """Eduka-Orca: returns the schema default (incl. *.gschema.override), or None.
+
+        Only used for the keys in eduka_defaults.VENDOR_OVERRIDABLE_KEYS, so that
+        administrators can change e.g. the default speech rate system-wide.
+        """
+
+        if (schema, key) not in eduka_defaults.VENDOR_OVERRIDABLE_KEYS:
+            return None
+        gschema = handle.get_schema()
+        if gschema is None or not gschema.has_key(key):
+            return None
+        try:
+            value = gschema.get_key(key).get_default_value().unpack()
+        except (AttributeError, TypeError, ValueError):
+            return None
+        msg = f"GSETTINGS REGISTRY: {schema}/{key} using schema/vendor default = {value!r}"
+        debug.print_message(debug.LEVEL_INFO, msg, True)
+        return value
+
     @staticmethod
     def _use_default(schema: str, key: str, default: Any) -> Any | None:
         """Returns default value, or None if no default was provided."""
