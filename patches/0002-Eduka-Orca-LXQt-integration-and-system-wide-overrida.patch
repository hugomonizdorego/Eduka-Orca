+# Eduka-Orca keyboard shortcut for lxqt-globalkeyshortcuts.
+#
+# Super+Alt+S turns Eduka-Orca on and off (the same shortcut GNOME uses for
+# its screen reader). Merge this section into the Eduka-Desktop default
+# /etc/xdg/lxqt/globalkeyshortcuts.conf, or into a user's
+# ~/.config/lxqt/globalkeyshortcuts.conf while lxqt-globalkeyshortcuts is
+# not running. The number after the dot must be unique in the file.
+
+[Meta%2BAlt%2BS.90]
+Comment=Eduka-Orca: turn the screen reader on/off
+Enabled=true
+Exec=eduka-orca-toggle
