diff --git a/eduka/org.edukasaun.EdukaOrca.gschema.xml b/eduka/org.edukasaun.EdukaOrca.gschema.xml
new file mode 100644
index 0000000..0f3a164
--- /dev/null
+++ b/eduka/org.edukasaun.EdukaOrca.gschema.xml
@@ -0,0 +1,63 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!--
+  Eduka-Orca settings that are not part of Orca itself.
+  Edited with eduka-orca-settings; read by eduka-orca, eduka-orca-toggle and
+  eduka-orca-autostart. Administrators can change the defaults system-wide with
+  a *.gschema.override file (see README.Eduka.md).
+-->
+<schemalist gettext-domain="eduka-orca">
+  <enum id="org.edukasaun.EdukaOrca.Language">
+    <value nick="en" value="0"/>
+    <value nick="pt" value="1"/>
+    <value nick="id" value="2"/>
+    <value nick="tet" value="3"/>
+    <value nick="system" value="4"/>
+  </enum>
+
+  <enum id="org.edukasaun.EdukaOrca.StartupMode">
+    <value nick="remember" value="0"/>
+    <value nick="always" value="1"/>
+    <value nick="never" value="2"/>
+  </enum>
+
+  <schema id="org.edukasaun.EdukaOrca" path="/org/edukasaun/eduka-orca/">
+    <key name="language" enum="org.edukasaun.EdukaOrca.Language">
+      <default>'en'</default>
+      <summary>Language of the screen reader and of Eduka-Orca Settings</summary>
+      <description>
+        en (English), pt (Portuguese), id (Indonesian), tet (Tetum) or system
+        (follow the language of the desktop session). Tetum is spoken with a
+        European Portuguese voice because eSpeak NG has no Tetum voice.
+      </description>
+    </key>
+    <key name="startup-mode" enum="org.edukasaun.EdukaOrca.StartupMode">
+      <default>'remember'</default>
+      <summary>When to start Eduka-Orca at login</summary>
+      <description>
+        remember: start if the screen reader was on at the end of the last
+        session; always: always start; never: never start automatically.
+      </description>
+    </key>
+    <key name="start-delay" type="i">
+      <range min="0" max="30"/>
+      <default>2</default>
+      <summary>Seconds to wait after login before starting</summary>
+    </key>
+    <key name="show-notifications" type="b">
+      <default>true</default>
+      <summary>Show a desktop notification when the screen reader is turned on or off</summary>
+    </key>
+    <key name="welcome-message" type="b">
+      <default>true</default>
+      <summary>Speak and show a welcome message when the screen reader starts</summary>
+    </key>
+    <key name="large-text" type="b">
+      <default>false</default>
+      <summary>Use larger text in Eduka-Orca Settings</summary>
+    </key>
+    <key name="high-contrast" type="b">
+      <default>false</default>
+      <summary>Use high-contrast colours in Eduka-Orca Settings</summary>
+    </key>
+  </schema>
+</schemalist>
