+@pytest.mark.unit
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [("en", ("en", "US")), ("id", ("id", "ID")), ("tet", ("tet", "TL")), ("", None), ("xx", None)],
+)
+def test_orca_language_override(monkeypatch: pytest.MonkeyPatch, value: str, expected: Any):
+    """Orca picks the voice language from EDUKA_ORCA_LANGUAGE (set by eduka-orca)."""
+
+    defaults = _load_eduka_defaults()
+    monkeypatch.setenv(defaults.LANGUAGE_ENVIRONMENT_VARIABLE, value)
+    assert defaults.get_language_override() == expected
+    assert tuple(code for code, _name in i18n.LANGUAGES) == defaults.SUPPORTED_LANGUAGES
+    if expected:
+        language, dialect = defaults.map_speech_language(*expected)
+        assert (language, dialect) != ("tet", "TL")  # Tetum is spoken with Portuguese.
