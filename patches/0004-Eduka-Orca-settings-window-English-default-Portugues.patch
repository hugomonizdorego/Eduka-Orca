+@pytest.fixture(scope="module", name="orca_schema")
+def fixture_orca_schema(tmp_path_factory: pytest.TempPathFactory) -> Path:
+    """Generates Orca's GSettings schema from the (patched) sources."""
+
+    output = tmp_path_factory.mktemp("schema") / "org.gnome.Orca.gschema.xml"
+    generator = TOOLS / "generate_gsettings_schemas.py"
+    subprocess.run([sys.executable, str(generator), str(SRC.parent), str(output)], check=True)
+    return output
