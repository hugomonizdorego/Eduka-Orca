+def _schema_keys(*paths: Path) -> dict[tuple[str, str], tuple[str, str]]:
+    """Returns {(schema id, key): (type, default)}; enum keys have type "s"."""
+
+    keys = {}
+    for path in paths:
+        for schema in ET.parse(path).getroot().iter("schema"):
+            for key in schema.iter("key"):
+                gtype = "s" if key.get("enum") else key.get("type", "")
+                default = (key.findtext("default") or "").strip()
+                keys[(schema.get("id", ""), key.get("name", ""))] = (gtype, default)
+    return keys
+
