+    keys = _schema_keys(EDUKA_SCHEMA_XML)
+    assert keys[("org.edukasaun.EdukaOrca", "language")][1] == "'en'"
+    assert i18n.DEFAULT_LANGUAGE == "en"
+    assert [code for code, _name in i18n.LANGUAGES] == ["en", "pt", "id", "tet"]
