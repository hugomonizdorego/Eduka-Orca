+@pytest.mark.unit
+def test_every_setting_exists_with_the_right_type(orca_schema: Path):
+    """Each setting in the window must map to a real key of the right type."""
+
+    keys = _schema_keys(orca_schema, EDUKA_SCHEMA_XML)
+    for setting in backend.SETTINGS.values():
+        if setting.schema == backend.A11Y_SCHEMA:
+            continue  # From gsettings-desktop-schemas.
+        assert (setting.schema, setting.key) in keys, setting.name
+        assert keys[(setting.schema, setting.key)][0] == setting.gtype, setting.name
+
+
+@pytest.mark.unit
+def test_window_defaults_match_schema_defaults(orca_schema: Path):
+    """The fallback defaults in backend.py must be the schema defaults."""
+
+    keys = _schema_keys(orca_schema, EDUKA_SCHEMA_XML)
+    for setting in backend.SETTINGS.values():
+        if setting.schema == backend.A11Y_SCHEMA:
+            continue
+        default = keys[(setting.schema, setting.key)][1]
+        value: Any = ast.literal_eval(default.replace("true", "True").replace("false", "False"))
+        assert value == setting.default, setting.name
+
