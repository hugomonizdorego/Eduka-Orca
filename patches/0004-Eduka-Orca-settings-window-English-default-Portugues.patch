+"""Translations for Eduka-Orca Settings.
+
+The source strings are English, which is also the default language. Translations
+live in eduka/po/<language>.po (gettext domain "eduka-orca"). The window's
+language is the one chosen in the Language page, not the desktop locale, so that
+it can be switched without logging out.
+"""
+
+from __future__ import annotations
+
+import gettext
+import locale
+import os
+
+DOMAIN = "eduka-orca"
+DEFAULT_LANGUAGE = "en"
+
+# Language codes in the order they are offered, with their names written in the
+# language itself (so that a user can always find their own language).
+LANGUAGES: tuple[tuple[str, str], ...] = (
+    ("en", "English"),
+    ("pt", "Português"),
+    ("id", "Bahasa Indonesia"),
+    ("tet", "Tetun"),
+)
+
+# Voice used to speak each language. eSpeak NG has no Tetum voice; Tetum spelling is
+# Portuguese-based, so a European Portuguese voice is the closest match.
+VOICE_LANGUAGES: dict[str, str] = {"en": "en", "pt": "pt-PT", "id": "id", "tet": "pt-PT"}
+
+# Gettext fallback chain for each language: Tetum falls back to Portuguese, which
+# Tetum speakers read, rather than straight to English.
+_FALLBACKS: dict[str, list[str]] = {
+    "en": ["en"],
+    "pt": ["pt", "pt_BR"],
+    "id": ["id"],
+    "tet": ["tet", "pt", "pt_BR"],
+}
+
+
+class _State:  # pylint: disable=too-few-public-methods
+    """The translation in use."""
+
+    localedir: str | None = None
+    translation: gettext.NullTranslations = gettext.NullTranslations()
+    language: str = DEFAULT_LANGUAGE
+
+
+def set_localedir(path: str | None) -> None:
+    """Sets where the compiled .mo files are installed (e.g. /usr/share/locale)."""
+
+    _State.localedir = path
+
+
+def system_language() -> str:
+    """Returns the supported language that matches the desktop locale, or English."""
+
+    for variable in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
+        for value in os.environ.get(variable, "").split(":"):
+            code = value.split(".")[0].split("_")[0].split("@")[0].lower()
+            if code in _FALLBACKS:
+                return code
+    try:
+        code = (locale.getlocale(locale.LC_MESSAGES)[0] or "").split("_")[0].lower()
+    except (AttributeError, ValueError):
+        code = ""
+    return code if code in _FALLBACKS else DEFAULT_LANGUAGE
+
+
+def resolve(language: str) -> str:
+    """Turns a stored language value ("system" included) into a supported language code."""
+
+    if language == "system":
+        return system_language()
+    return language if language in _FALLBACKS else DEFAULT_LANGUAGE
+
+
+def set_language(language: str) -> str:
+    """Switches the translation used by _(). Returns the language code now in use."""
+
+    _State.language = resolve(language)
+    _State.translation = gettext.translation(
+        DOMAIN, _State.localedir, languages=_FALLBACKS[_State.language], fallback=True
+    )
+    return _State.language
+
+
+def current_language() -> str:
+    """Returns the language code in use."""
+
+    return _State.language
+
+
+def _(message: str) -> str:
+    """Translates message into the current language."""
+
+    return _State.translation.gettext(message)
+
+
+def N_(message: str) -> str:  # pylint: disable=invalid-name
+    """Marks message for translation without translating it yet."""
+
+    return message
