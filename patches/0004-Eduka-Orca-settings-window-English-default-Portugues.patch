+def test_system_language(monkeypatch: pytest.MonkeyPatch, environment: dict, expected: str):
+    """ "Same as the desktop" picks the matching supported language, or English."""
+
+    for variable in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
+        monkeypatch.delenv(variable, raising=False)
+    for variable, value in environment.items():
+        monkeypatch.setenv(variable, value)
+    monkeypatch.setattr(i18n.locale, "getlocale", lambda *_args: (None, None))
+    assert i18n.resolve("system") == expected
