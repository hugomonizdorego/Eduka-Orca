+    --on) turn_on ;;
+    --off) turn_off ;;
+    --restart)
+        remember true
+        stop
+        start
+        notify "$(msg_on)"
+        ;;
+    --status)
+        if is_running; then echo on; else echo off; fi
+        ;;
+    -h | --help)
+        echo "Usage: eduka-orca-toggle [--on | --off | --restart | --status]"
+        echo "Without an option, turns the screen reader on if it is off, and off if it is on."
+        ;;
+    '')
+        if is_running; then turn_off; else turn_on; fi
+        ;;
+    *)
+        echo "eduka-orca-toggle: unknown option: $1 (try --help)" >&2
+        exit 2
+        ;;
+esac
