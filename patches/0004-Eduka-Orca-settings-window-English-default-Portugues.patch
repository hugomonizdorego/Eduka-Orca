         id*) echo "Eduka-Orca aktif" ;;
         *) echo "Eduka-Orca is on" ;;
     esac
 }
 
 msg_off() {
-    case "${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-$LANG}}}" in
-        tet*) echo "Eduka-Orca la ativu" ;;
-        pt*) echo "Eduka-Orca desativado" ;;
+    case "$MESSAGE_LANGUAGE" in
