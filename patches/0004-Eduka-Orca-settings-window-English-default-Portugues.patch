+
+    @staticmethod
+    def _section(page: Gtk.Box, title: str) -> Gtk.ListBox:
+        if title:
+            label = Gtk.Label(label=title, xalign=0)
+            label.get_style_context().add_class("eduka-section-title")
+            page.pack_start(label, False, False, 0)
+        card = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
+        card.get_style_context().add_class("eduka-card")
+        if title:
+            _set_accessible(card, title)
+        page.pack_start(card, False, False, 0)
+        return card
+
+    @staticmethod
+    def _row(
+        card: Gtk.ListBox,
+        title: str,
+        subtitle: str,
+        control: Gtk.Widget | None,
+        vertical: bool = False,
+    ) -> Gtk.ListBoxRow:
+        row = Gtk.ListBoxRow(activatable=False)
+        orientation = Gtk.Orientation.VERTICAL if vertical else Gtk.Orientation.HORIZONTAL
+        line = Gtk.Box(orientation=orientation, spacing=8 if vertical else 16)
+        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
+        title_label = Gtk.Label(label=title, xalign=0, wrap=True, use_underline=False)
+        title_label.get_style_context().add_class("eduka-row-title")
+        texts.pack_start(title_label, False, False, 0)
+        if subtitle:
+            sub = Gtk.Label(label=subtitle, xalign=0, wrap=True)
+            sub.get_style_context().add_class("eduka-row-subtitle")
+            texts.pack_start(sub, False, False, 0)
+        line.pack_start(texts, True, True, 0)
+        if control is not None:
+            if not vertical:
+                control.set_valign(Gtk.Align.CENTER)
+            line.pack_end(control, vertical, vertical, 0)
+            title_label.set_mnemonic_widget(control)
+            _set_accessible(control, title, subtitle)
+        row.add(line)
+        card.add(row)
+        return row
