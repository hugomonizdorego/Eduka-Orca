+    # ------------------------------------------------------------------ building
+
+    def _build(self) -> None:
+        """(Re)builds every widget in the current language."""
+
+        for child in self._root.get_children():
+            self._root.remove(child)
+            child.destroy()
+        self._status_widgets = []
+        self._views = {}
+
+        self.set_title(_("Eduka-Orca Settings"))
+        self._header.set_title(_("Eduka-Orca Settings"))
+        self._header.set_subtitle(_("Screen reader with slow speech and captions"))
+
+        self._infobar = Gtk.InfoBar(message_type=Gtk.MessageType.INFO, show_close_button=True)
+        self._infobar.set_no_show_all(True)
+        self._infobar_label = Gtk.Label(xalign=0, wrap=True)
+        self._infobar.get_content_area().add(self._infobar_label)
+        self._infobar.add_button(_("Restart now"), Gtk.ResponseType.APPLY)
+        self._infobar.connect("response", self._on_infobar_response)
+        self._root.pack_start(self._infobar, False, False, 0)
+
+        if self._store.missing_schemas:
+            warning = Gtk.InfoBar(message_type=Gtk.MessageType.WARNING)
+            label = Gtk.Label(
+                label=_(
+                    "Some settings could not be found, so changes will not be saved. "
+                    "Please reinstall the eduka-orca package."
+                ),
+                xalign=0,
+                wrap=True,
+            )
+            warning.get_content_area().add(label)
+            self._root.pack_start(warning, False, False, 0)
+
+        paned = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
+        self._root.pack_start(paned, True, True, 0)
+
+        self._stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
+        builders = {
+            "home": self._build_home,
+            "language": self._build_language,
+            "speech": self._build_speech,
+            "captions": self._build_captions,
+            "reading": self._build_reading,
+            "startup": self._build_startup,
+            "about": self._build_about,
+        }
+        for page_id, _icon, title in PAGES:
+            scrolled = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
+            content = builders[page_id]()
+            clamp = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
+            clamp.set_halign(Gtk.Align.FILL)
+            clamp.pack_start(content, False, False, 0)
