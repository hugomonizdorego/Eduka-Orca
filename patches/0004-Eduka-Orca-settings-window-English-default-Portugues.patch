+@pytest.mark.unit
+def test_tetum_falls_back_to_portuguese(tmp_path: Path):
+    """Strings missing from Tetum are shown in Portuguese, not English."""
+
+    if shutil.which("msgfmt") is None:
+        pytest.skip("msgfmt is not installed")
+    for language, msgstr in (("pt", "Fala"), ("tet", "")):
+        directory = tmp_path / language / "LC_MESSAGES"
+        directory.mkdir(parents=True)
+        po = tmp_path / f"{language}.po"
+        po.write_text(
+            'msgid ""\nmsgstr "Content-Type: text/plain; charset=UTF-8\\n"\n\n'
+            f'msgid "Speech"\nmsgstr "{msgstr}"\n',
+            encoding="utf-8",
+        )
+        subprocess.run(["msgfmt", "-o", str(directory / "eduka-orca.mo"), str(po)], check=True)
+    i18n.set_localedir(str(tmp_path))
+    try:
+        assert i18n.set_language("tet") == "tet"
+        assert i18n._("Speech") == "Fala"
+        assert i18n.set_language("en") == "en"
+        assert i18n._("Speech") == "Speech"
+        assert i18n.set_language("unknown") == "en"
+    finally:
+        i18n.set_localedir(None)
+        i18n.set_language("en")
