+def _hex_from_rgba(rgba: Gdk.RGBA) -> str:
+    red, green, blue = (round(channel * 255) for channel in (rgba.red, rgba.green, rgba.blue))
+    return f"#{red:02x}{green:02x}{blue:02x}"
+
+
+def _rgba_from_hex(value: str) -> Gdk.RGBA:
+    rgba = Gdk.RGBA()
+    if not rgba.parse(value):
+        rgba.parse("#000000")
+    return rgba
+
+
+def _set_accessible(widget: Gtk.Widget, name: str, description: str = "") -> None:
+    accessible = widget.get_accessible()
+    if accessible is None:
+        return
+    accessible.set_name(name)
+    if description:
+        accessible.set_description(description)
