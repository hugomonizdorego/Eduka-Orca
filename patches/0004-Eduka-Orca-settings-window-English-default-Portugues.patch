+def _po_entries(language: str) -> dict[str, str]:
+    text = (EDUKA / "po" / f"{language}.po").read_text(encoding="utf-8")
+    entries = {}
+    for msgid, msgstr in re.findall(r'^msgid "(.*)"\nmsgstr "(.*)"$', text, re.MULTILINE):
+        entries[msgid.replace('\\"', '"')] = msgstr.replace('\\"', '"')
+    return entries
+
