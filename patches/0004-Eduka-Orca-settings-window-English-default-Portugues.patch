+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+# Lesser General Public License for more details.
+
+"""The Eduka-Orca Settings window (GTK 3).
+
+The window is built for people who are hard of hearing or have low vision: large
+controls, a short description under every option, keyboard navigation everywhere,
+and every change is saved and applied at once (there is no "Apply" button to forget).
+"""
+
+# pylint: disable=too-many-lines,too-many-instance-attributes,too-many-public-methods
+
+from __future__ import annotations
+
+import sys
+from typing import TYPE_CHECKING, Any
+
+import gi
+
+gi.require_version("Gdk", "3.0")
+gi.require_version("Gtk", "3.0")
+from gi.repository import Gdk, Gio, GLib, Gtk
+
+from . import VERSION, backend, i18n
+from .i18n import N_, _
+
+if TYPE_CHECKING:
+    from collections.abc import Callable
+
+APPLICATION_ID = "org.edukasaun.EdukaOrca.Settings"
+SAVE_DELAY_MS = 250
+
+CSS = b"""
+.eduka-sidebar { background-color: alpha(@theme_fg_color, 0.04); }
+.eduka-sidebar row { padding: 10px 14px; border-radius: 8px; margin: 2px 8px; }
+.eduka-sidebar row:selected { background-color: @theme_selected_bg_color;
+                              color: @theme_selected_fg_color; }
+.eduka-sidebar-brand { padding: 18px 16px 10px 16px; }
+.eduka-brand-title { font-size: 1.25em; font-weight: bold; }
+.eduka-page { padding: 24px 32px 32px 32px; }
+.eduka-page-title { font-size: 1.7em; font-weight: bold; }
+.eduka-page-intro { color: alpha(@theme_fg_color, 0.78); }
+.eduka-section-title { font-weight: bold; color: alpha(@theme_fg_color, 0.85);
+                       margin-top: 10px; }
+.eduka-card { background-color: @theme_base_color; border-radius: 12px;
+              border: 1px solid alpha(@theme_fg_color, 0.14); }
+.eduka-card row { padding: 12px 16px; }
+.eduka-card row:not(:last-child) { border-bottom: 1px solid alpha(@theme_fg_color, 0.08); }
+.eduka-row-title { font-weight: bold; }
+.eduka-row-subtitle { color: alpha(@theme_fg_color, 0.72); }
+.eduka-hero { border-radius: 16px; padding: 22px 26px; }
+.eduka-hero-on { background-image: linear-gradient(135deg, #1b6e3c, #2e9a57); color: #ffffff; }
+.eduka-hero-off { background-image: linear-gradient(135deg, #4a4f57, #6b717b); color: #ffffff; }
+.eduka-hero-title { font-size: 1.6em; font-weight: bold; }
+.eduka-big-button { font-size: 1.2em; font-weight: bold; padding: 10px 26px;
+                    border-radius: 10px; }
+.eduka-preset { padding: 6px 14px; border-radius: 18px; }
+.eduka-caption-preview { font-weight: bold; padding: 14px 18px; border-radius: 10px; }
+.eduka-note { background-color: alpha(@theme_selected_bg_color, 0.12);
+              border-radius: 10px; padding: 10px 14px; }
+window.eduka-large-text { font-size: 14pt; }
+window.eduka-high-contrast,
+window.eduka-high-contrast .eduka-card,
+window.eduka-high-contrast .eduka-sidebar,
+window.eduka-high-contrast .eduka-note { background-color: #000000; color: #ffff00;
+                                         border-color: #ffff00; }
+window.eduka-high-contrast .eduka-row-subtitle,
+window.eduka-high-contrast .eduka-page-intro,
+window.eduka-high-contrast .eduka-section-title { color: #ffffff; }
+window.eduka-high-contrast button { background-image: none; background-color: #000000;
+                                    color: #ffff00; border: 2px solid #ffff00; }
+window.eduka-high-contrast headerbar { background-image: none; background-color: #000000;
+                                       color: #ffff00; border-color: #ffff00; }
+window.eduka-high-contrast headerbar .subtitle { color: #ffffff; }
+window.eduka-high-contrast .eduka-sidebar row:selected { background-color: #ffff00;
+                                                         color: #000000; }
+"""
+
+# Page id, icon, title (translated at build time).
+PAGES: tuple[tuple[str, str, str], ...] = (
+    ("home", "go-home-symbolic", N_("Home")),
+    ("language", "preferences-desktop-locale-symbolic", N_("Language")),
+    ("speech", "audio-volume-high-symbolic", N_("Speech")),
+    ("captions", "media-view-subtitles-symbolic", N_("Captions")),
+    ("reading", "input-keyboard-symbolic", N_("Reading and typing")),
+    ("startup", "system-run-symbolic", N_("Startup")),
+    ("about", "help-about-symbolic", N_("About")),
+)
+
+RATE_PRESET_LABELS = {
+    "very-slow": N_("Very slow"),
