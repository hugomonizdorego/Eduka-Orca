+
+class SettingsStore:
+    """Reads and writes settings in GSettings, falling back to memory if a schema is missing.
+
+    The fallback keeps the window usable on a development machine where the schemas are
+    not installed; :attr:`missing_schemas` tells the window to warn that nothing is saved.
+    """
+
+    def __init__(self, source: Gio.SettingsSchemaSource | None = None) -> None:
+        self._source = source if source is not None else Gio.SettingsSchemaSource.get_default()
+        self._gsettings: dict[tuple[str, str | None], Gio.Settings | None] = {}
+        self._memory: dict[str, Any] = {}
+        self.missing_schemas: set[str] = set()
+
+    def _settings_for(self, setting: Setting) -> Gio.Settings | None:
+        cache_key = (setting.schema, setting.path)
+        if cache_key in self._gsettings:
+            return self._gsettings[cache_key]
+
+        gsettings = None
+        schema = self._source.lookup(setting.schema, True) if self._source else None
+        if schema is None or not schema.has_key(setting.key):
+            self.missing_schemas.add(setting.schema)
+        else:
+            gsettings = Gio.Settings.new_full(schema, None, setting.path)
+        self._gsettings[cache_key] = gsettings
+        return gsettings
+
+    def get(self, name: str) -> Any:
+        """Returns the current value of the named setting."""
+
+        setting = SETTINGS[name]
+        gsettings = self._settings_for(setting)
+        if gsettings is None:
+            return self._memory.get(name, setting.default)
+        return gsettings.get_value(setting.key).unpack()
+
+    def set(self, name: str, value: Any) -> None:
+        """Saves the named setting."""
+
+        setting = SETTINGS[name]
+        value = coerce(setting, value)
+        gsettings = self._settings_for(setting)
+        if gsettings is None:
+            self._memory[name] = value
+            return
+        gsettings.set_value(setting.key, GLib.Variant(setting.gtype, value))
+        if setting.schema == "org.gnome.Orca.Voice":
+            # Orca marks voices the user has customised as "established".
+            gsettings.set_boolean("established", True)
+
+    def reset(self, name: str) -> None:
+        """Returns the named setting to its default (the schema or vendor default)."""
+
+        setting = SETTINGS[name]
+        gsettings = self._settings_for(setting)
+        if gsettings is None:
+            self._memory.pop(name, None)
+        else:
+            gsettings.reset(setting.key)
+
+    def sync(self) -> None:
+        """Writes pending changes to disk."""
+
+        Gio.Settings.sync()
+
+
+def coerce(setting: Setting, value: Any) -> Any:
+    """Converts a widget value into the type stored in GSettings."""
+
+    if setting.gtype == "b":
+        return bool(value)
+    if setting.gtype == "i":
+        return round(float(value))
+    if setting.gtype == "d":
+        return round(float(value), 2)
+    return str(value)
+
+
+def rate_to_speech_dispatcher(rate: int) -> int:
+    """Converts Orca's 0-100 rate to speech-dispatcher's -100..100 (as Orca does)."""
+
+    return max(-100, min(100, 2 * int(rate) - 100))
+
+
+def pitch_to_speech_dispatcher(pitch: float) -> int:
+    """Converts Orca's 0-10 pitch to speech-dispatcher's -100..100 (as Orca does)."""
+
+    return int(20 * max(0.0, min(9.0, float(pitch))) - 90)
+
+
+class OrcaController:
+    """Starts, stops and talks to the running Orca."""
+
+    def __init__(self, connection: Gio.DBusConnection | None = None) -> None:
+        self._connection = connection
+        if self._connection is None:
+            try:
+                self._connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
+            except GLib.Error:
+                self._connection = None
+
+    def _call(
+        self,
+        object_path: str,
+        interface: str,
+        method: str,
+        parameters: GLib.Variant | None,
+        reply_type: str | None = None,
+    ) -> GLib.Variant | None:
+        if self._connection is None:
+            return None
+        try:
+            return self._connection.call_sync(
+                ORCA_BUS_NAME,
+                object_path,
+                interface,
+                method,
+                parameters,
+                GLib.VariantType(reply_type) if reply_type else None,
+                Gio.DBusCallFlags.NO_AUTO_START,
+                DBUS_TIMEOUT_MS,
+                None,
+            )
+        except GLib.Error:
+            return None
+
+    def is_running(self) -> bool:
+        """Returns True if Orca's D-Bus service is on the session bus."""
+
+        if self._connection is None:
+            return False
+        try:
+            reply = self._connection.call_sync(
+                "org.freedesktop.DBus",
+                "/org/freedesktop/DBus",
+                "org.freedesktop.DBus",
+                "NameHasOwner",
+                GLib.Variant("(s)", (ORCA_BUS_NAME,)),
+                GLib.VariantType("(b)"),
+                Gio.DBusCallFlags.NONE,
+                DBUS_TIMEOUT_MS,
+                None,
+            )
+        except GLib.Error:
+            return False
+        return bool(reply.unpack()[0])
+
+    def apply(self, setting: Setting, value: Any) -> bool:
+        """Applies a setting to the running Orca. Returns True if Orca accepted it."""
+
+        if not setting.dbus_module or not setting.dbus_setter:
+            return False
+        vtype, dbus_value = setting.dbus_value(coerce(setting, value))
+        reply = self._call(
+            f"{ORCA_OBJECT_PATH}/{setting.dbus_module}",
+            ORCA_MODULE_INTERFACE,
+            "ExecuteRuntimeSetter",
+            GLib.Variant("(sv)", (setting.dbus_setter, GLib.Variant(vtype, dbus_value))),
+        )
+        return bool(reply is not None and reply.unpack() and reply.unpack()[0])
+
+    def present_message(self, message: str) -> bool:
+        """Asks Orca to speak (and caption) a message."""
+
+        reply = self._call(
+            ORCA_OBJECT_PATH,
+            ORCA_SERVICE_INTERFACE,
+            "PresentMessage",
+            GLib.Variant("(s)", (message,)),
+        )
+        return reply is not None
+
+    def show_orca_preferences(self) -> bool:
+        """Opens Orca's own (advanced) preferences dialog."""
+
+        if self._call(ORCA_OBJECT_PATH, ORCA_SERVICE_INTERFACE, "ShowPreferences", None):
+            return True
+        return _spawn(["eduka-orca", "--replace", "--setup"])
+
+    @staticmethod
+    def turn_on() -> bool:
+        """Starts Eduka-Orca and remembers that it is on."""
+
+        return _spawn(["eduka-orca-toggle", "--on"])
+
+    @staticmethod
+    def turn_off() -> bool:
+        """Stops Eduka-Orca and remembers that it is off."""
+
+        return _spawn(["eduka-orca-toggle", "--off"])
+
+    @staticmethod
+    def restart() -> bool:
+        """Restarts Eduka-Orca so that settings such as the language take effect."""
+
+        return _spawn(["eduka-orca-toggle", "--restart"])
+
+
+def _spawn(argv: list[str]) -> bool:
+    if shutil.which(argv[0]) is None:
+        return False
+    try:
+        subprocess.Popen(  # pylint: disable=consider-using-with
+            argv,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            start_new_session=True,
+        )
+    except OSError:
+        return False
+    return True
+
+
+def speak_sample(text: str, language: str, rate: int, pitch: float, volume: float) -> bool:
+    """Speaks text with speech-dispatcher directly (used when Orca is not running)."""
+
+    if shutil.which("spd-say") is None:
+        return False
+    argv = [
+        "spd-say",
+        "--wait",
+        "-l",
+        language,
+        "-r",
+        str(rate_to_speech_dispatcher(rate)),
+        "-p",
+        str(pitch_to_speech_dispatcher(pitch)),
+        "-i",
+        str(int(15 * max(0.0, min(9.0, float(volume))) - 35)),
+        text,
+    ]
+    return _spawn(argv)
