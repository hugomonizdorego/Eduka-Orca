--- a/src/orca/eduka_defaults.py
+++ b/src/orca/eduka_defaults.py
@@ -34,6 +34,8 @@ checks that they stay in sync with the values below.
 
 from __future__ import annotations
 
+import os
+
 # Speech rate on Orca's 0-100 scale (upstream default: 50).
 # Speech-dispatcher receives 2 * rate - 100, so 30 becomes -40.
 DEFAULT_RATE: int = 30
@@ -81,3 +83,29 @@ def map_speech_language(language: str, dialect: str) -> tuple[str, str]:
     """Returns (language, dialect), replaced by a fallback voice language when needed."""
 
     return SPEECH_LANGUAGE_FALLBACKS.get((language or "").lower(), (language, dialect))
+
+
+# Languages offered by Eduka-Orca Settings. English is the default; Tetum, Portuguese
+# and Indonesian are the languages of Timor-Leste and its neighbours.
+SUPPORTED_LANGUAGES: tuple[str, ...] = ("en", "pt", "id", "tet")
+DEFAULT_LANGUAGE: str = "en"
+
+# Locale (language, territory) used for each supported language.
+LANGUAGE_LOCALES: dict[str, tuple[str, str]] = {
+    "en": ("en", "US"),
+    "pt": ("pt", "PT"),
+    "id": ("id", "ID"),
+    "tet": ("tet", "TL"),
+}
+
+# The eduka-orca launcher exports the language chosen in Eduka-Orca Settings in this
+# variable. It decides the voice language even when the matching system locale is not
+# installed (Orca otherwise takes the voice language from the locale).
+LANGUAGE_ENVIRONMENT_VARIABLE: str = "EDUKA_ORCA_LANGUAGE"
+
+
+def get_language_override() -> tuple[str, str] | None:
+    """Returns the (language, territory) chosen in Eduka-Orca Settings, or None."""
+
+    code = os.environ.get(LANGUAGE_ENVIRONMENT_VARIABLE, "").strip().lower()
+    return LANGUAGE_LOCALES.get(code)
