+"""Reads and writes Eduka-Orca and Orca settings, and controls the running screen reader.
+
+Nothing here imports GTK, so it can be unit tested without a display.
+
+Settings are saved in GSettings (dconf), where Orca reads them:
+
+* Eduka-Orca's own settings live in ``org.edukasaun.EdukaOrca``.
+* Orca's settings live in its relocatable schemas under ``/org/gnome/orca/default/``
+  (the "default" profile, which is the only profile Orca starts with).
+
+When Orca is running, every change is also sent to it over D-Bus
+(``org.gnome.Orca.Service``) so that it takes effect immediately.
+"""
+
+from __future__ import annotations
+
+import shutil
+import subprocess
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any
+
+from gi.repository import Gio, GLib
+
+if TYPE_CHECKING:
+    from collections.abc import Callable
+
+EDUKA_SCHEMA = "org.edukasaun.EdukaOrca"
+A11Y_SCHEMA = "org.gnome.desktop.a11y.applications"
+ORCA_PROFILE_PATH = "/org/gnome/orca/default/"
+
+ORCA_BUS_NAME = "org.gnome.Orca.Service"
+ORCA_OBJECT_PATH = "/org/gnome/Orca/Service"
+ORCA_SERVICE_INTERFACE = "org.gnome.Orca.Service"
+ORCA_MODULE_INTERFACE = "org.gnome.Orca.Module"
+DBUS_TIMEOUT_MS = 2000
+
+# Values used by Eduka-Orca when nothing else is set (see src/orca/eduka_defaults.py).
+DEFAULT_RATE = 30
+DEFAULT_PITCH = 4.5
+DEFAULT_VOLUME = 10.0
+
+# Speech-rate presets shown as buttons next to the speed slider.
+RATE_PRESETS: tuple[tuple[str, int], ...] = (
+    ("very-slow", 20),
+    ("slow", DEFAULT_RATE),
+    ("normal", 50),
+    ("fast", 65),
+)
+
+# Caption colour presets: (id, text colour, background colour).
+CAPTION_PRESETS: tuple[tuple[str, str, str], ...] = (
+    ("yellow-on-black", "#ffff00", "#000000"),
+    ("white-on-black", "#ffffff", "#000000"),
+    ("black-on-white", "#000000", "#ffffff"),
+    ("black-on-yellow", "#000000", "#ffff00"),
+)
+
+
+@dataclass(frozen=True)
+class Setting:
+    """One setting shown in Eduka-Orca Settings."""
+
+    name: str
+    schema: str
+    key: str
+    gtype: str  # GVariant type of the key: b, i, d or s (enums are s)
+    default: Any
+    path: str | None = None  # None for non-relocatable schemas
+    dbus_module: str | None = None  # Orca D-Bus module that can apply it live
+    dbus_setter: str | None = None
+    to_dbus: Callable[[Any], tuple[str, Any]] | None = None  # (variant type, value)
+
+    def dbus_value(self, value: Any) -> tuple[str, Any]:
+        """Returns the (GVariant type, value) sent to Orca's runtime setter."""
+
+        if self.to_dbus is not None:
+            return self.to_dbus(value)
+        return self.gtype, value
+
+
+def _orca(schema_name: str) -> str:
+    return f"{ORCA_PROFILE_PATH}{schema_name}/"
+
+
+_VOICE_PATH = f"{ORCA_PROFILE_PATH}voices/default/"
+
+SETTINGS: dict[str, Setting] = {
+    setting.name: setting
+    for setting in (
+        # Eduka-Orca's own settings.
+        Setting("language", EDUKA_SCHEMA, "language", "s", "en"),
+        Setting("startup-mode", EDUKA_SCHEMA, "startup-mode", "s", "remember"),
+        Setting("start-delay", EDUKA_SCHEMA, "start-delay", "i", 2),
+        Setting("show-notifications", EDUKA_SCHEMA, "show-notifications", "b", True),
+        Setting("welcome-message", EDUKA_SCHEMA, "welcome-message", "b", True),
+        Setting("large-text", EDUKA_SCHEMA, "large-text", "b", False),
+        Setting("high-contrast", EDUKA_SCHEMA, "high-contrast", "b", False),
+        # Voice.
+        Setting(
+            "rate",
+            "org.gnome.Orca.Voice",
+            "rate",
+            "i",
+            DEFAULT_RATE,
+            _VOICE_PATH,
+            "SpeechManager",
+            "Rate",
+        ),
+        Setting(
+            "pitch",
+            "org.gnome.Orca.Voice",
+            "pitch",
+            "d",
+            DEFAULT_PITCH,
+            _VOICE_PATH,
+            "SpeechManager",
+            "Pitch",
+        ),
+        Setting(
+            "volume",
+            "org.gnome.Orca.Voice",
+            "volume",
+            "d",
+            DEFAULT_VOLUME,
+            _VOICE_PATH,
+            "SpeechManager",
+            "Volume",
+        ),
+        Setting(
+            "speech-enabled",
+            "org.gnome.Orca.Speech",
+            "enable",
+            "b",
+            True,
+            _orca("speech"),
+            "SpeechManager",
+            "SpeechIsEnabled",
+        ),
+        Setting(
+            "punctuation-level",
+            "org.gnome.Orca.Speech",
+            "punctuation-level",
+            "s",
+            "most",
+            _orca("speech"),
+            "SpeechManager",
+            "PunctuationLevel",
+        ),
+        Setting(
+            "capitalization-style",
+            "org.gnome.Orca.Speech",
+            "capitalization-style",
+            "s",
+            "none",
+            _orca("speech"),
+            "SpeechManager",
+            "CapitalizationStyle",
+        ),
+        Setting(
+            "verbosity-level",
+            "org.gnome.Orca.Speech",
+            "verbosity-level",
+            "s",
+            "verbose",
+            _orca("speech"),
