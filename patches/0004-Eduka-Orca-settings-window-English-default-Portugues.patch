+    # Small widget helpers ----------------------------------------------------
+
+    @staticmethod
+    def _page(title: str, intro: str) -> Gtk.Box:
+        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
+        page.get_style_context().add_class("eduka-page")
+        label = Gtk.Label(label=title, xalign=0)
