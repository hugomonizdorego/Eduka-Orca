-        gsettings set "$SCHEMA" "$KEY" "$1" 2>/dev/null || true
+        gsettings set "$A11Y_SCHEMA" "$A11Y_KEY" "$1" 2>/dev/null || true
     fi
 }
 
-if pgrep -u "$UID_NOW" -x orca >/dev/null 2>&1; then
-    set_key false
-    pkill -TERM -u "$UID_NOW" -x orca
-    say "$(msg_off)"
-else
-    set_key true
+is_running() {
+    pgrep -u "$UID_NOW" -x orca >/dev/null 2>&1
+}
+
+start() {
     if command -v setsid >/dev/null 2>&1; then
         setsid /usr/bin/eduka-orca --replace >/dev/null 2>&1 &
     else
         nohup /usr/bin/eduka-orca --replace >/dev/null 2>&1 &
     fi
-    say "$(msg_on)"
-fi
+}
+
+stop() {
+    pkill -TERM -u "$UID_NOW" -x orca 2>/dev/null
+    # Wait up to 5 seconds for Orca to exit, so a restart does not race it.
+    tries=0
+    while is_running && [ "$tries" -lt 25 ]; do
+        sleep 0.2
+        tries=$((tries + 1))
+    done
+}
+
+turn_on() {
+    remember true
+    is_running || start
+    notify "$(msg_on)"
+}
+
+turn_off() {
+    remember false
+    stop
+    notify "$(msg_off)"
+}
