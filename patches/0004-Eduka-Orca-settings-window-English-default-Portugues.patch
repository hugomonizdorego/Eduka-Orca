+            _("Choose a colour combination that is easy to read."),
+            presets,
+            vertical=True,
+        )
+
+        self._fg_button = Gtk.ColorButton.new_with_rgba(
+            _rgba_from_hex(str(self._store.get("captions-foreground")))
+        )
+        self._fg_button.connect("color-set", self._on_caption_color, "captions-foreground")
+        self._row(card, _("Text colour"), "", self._fg_button)
+        self._bg_button = Gtk.ColorButton.new_with_rgba(
+            _rgba_from_hex(str(self._store.get("captions-background")))
+        )
+        self._bg_button.connect("color-set", self._on_caption_color, "captions-background")
+        self._row(card, _("Background colour"), "", self._bg_button)
+
+        card = self._section(page, _("Preview"))
+        row = Gtk.ListBoxRow(activatable=False)
+        row.add(self._caption_preview)
+        card.add(row)
+        self._update_caption_preview()
+        return page
+
+    def _build_reading(self) -> Gtk.Widget:
+        page = self._page(
+            _("Reading and typing"),
+            _("How much the screen reader says, and what it says while you type."),
+        )
+        card = self._section(page, _("Reading"))
+        self._row(
+            card,
+            _("Amount of detail"),
+            _("Brief says less about each item; detailed says more."),
+            self._combo("verbosity-level", VERBOSITY_LEVELS),
+        )
+        self._row(
+            card,
+            _("Tutorial messages"),
+            _("Explain how to use buttons, lists and other items."),
+            self._switch("speak-tutorial-messages"),
+        )
+        self._row(
+            card,
+            _("Read under the mouse"),
+            _("Read what is under the mouse pointer. Used after the next restart."),
+            self._switch("mouse-review"),
+        )
+
+        card = self._section(page, _("Keyboard"))
+        self._row(
+            card,
+            _("Keyboard layout"),
+            _("Choose Laptop if your keyboard has no Insert key."),
+            self._combo("keyboard-layout", KEYBOARD_LAYOUTS),
+        )
+        self._row(
+            card, _("Speak keys"), _("Say each key as you press it."), self._switch("key-echo")
+        )
+        self._row(
+            card,
+            _("Speak characters"),
+            _("Say each character as it is typed."),
+            self._switch("character-echo"),
+        )
+        self._row(
+            card, _("Speak words"), _("Say each word after you type it."), self._switch("word-echo")
+        )
+        self._row(
+            card,
+            _("Speak sentences"),
+            _("Say each sentence after you type it."),
+            self._switch("sentence-echo"),
+        )
+
+        card = self._section(page, _("Other output"))
+        self._row(
+            card,
+            _("Sounds"),
+            _("Play short sounds, for example for progress bars."),
+            self._switch("sound-enabled"),
+        )
+        self._row(
+            card,
+            _("Braille"),
+            _("Use a braille display if one is connected."),
+            self._switch("braille-enabled"),
+        )
+        return page
+
+    def _build_startup(self) -> Gtk.Widget:
+        page = self._page(
+            _("Startup"),
+            _("Choose when the screen reader starts and how it tells you it is on."),
+        )
+        card = self._section(page, _("Start at login"))
+        current = str(self._store.get("startup-mode"))
+        group: Gtk.RadioButton | None = None
+        for mode, title, description in STARTUP_MODES:
+            radio = Gtk.RadioButton.new_from_widget(group)
+            group = group or radio
+            texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
+            title_label = Gtk.Label(label=_(title), xalign=0)
+            title_label.get_style_context().add_class("eduka-row-title")
+            sub = Gtk.Label(label=_(description), xalign=0, wrap=True)
+            sub.get_style_context().add_class("eduka-row-subtitle")
+            texts.pack_start(title_label, False, False, 0)
+            texts.pack_start(sub, False, False, 0)
+            radio.add(texts)
+            radio.set_active(mode == current)
+            _set_accessible(radio, _(title), _(description))
+            radio.connect(
+                "toggled", lambda w, m=mode: w.get_active() and self._changed("startup-mode", m)
+            )
+            row = Gtk.ListBoxRow(activatable=False)
+            row.add(radio)
+            card.add(row)
+
+        card = self._section(page, _("When starting"))
+        delay = Gtk.SpinButton.new_with_range(0, 30, 1)
+        delay.set_value(int(self._store.get("start-delay")))
+        delay.connect("value-changed", lambda w: self._changed("start-delay", w.get_value_as_int()))
+        self._row(
+            card,
+            _("Wait before starting"),
+            _("Seconds to wait after login, so the desktop is ready first."),
+            delay,
+        )
+        self._row(
+            card,
+            _("Welcome message"),
+            _("Say and show “Eduka-Orca is ready” when it starts."),
+            self._switch("welcome-message"),
+        )
+        self._row(
+            card,
+            _("Notifications"),
+            _("Show a message on the screen when the screen reader is turned on or off."),
+            self._switch("show-notifications"),
+        )
+        return page
+
+    def _build_about(self) -> Gtk.Widget:
+        page = self._page(_("About"), "")
+        card = self._section(page, "")
+        version = Gtk.Label(label=VERSION, selectable=True)
+        self._row(
+            card,
+            "Eduka-Orca",
+            _("The Orca screen reader for Edukasaun OS, with slow speech and on-screen captions."),
+            version,
+        )
+
+        card = self._section(page, _("Keyboard shortcuts"))
+        for keys, description in SHORTCUTS:
+            key_label = Gtk.Label(label=keys)
+            key_label.get_style_context().add_class("eduka-row-title")
+            self._row(card, _(description), "", key_label)
+
+        card = self._section(page, _("Reset"))
+        reset = Gtk.Button(label=_("Reset all settings"))
+        reset.get_style_context().add_class("destructive-action")
+        reset.connect("clicked", self._on_reset_all)
+        self._row(
+            card,
+            _("Reset all settings"),
+            _("Go back to the Eduka-Orca defaults: English, slow speech and captions."),
+            reset,
+        )
+        licence = Gtk.Label(
+            label=_(
+                "Eduka-Orca is free software, licensed under the GNU LGPL 2.1 or later. "
+                "It is based on Orca by the GNOME Project."
+            ),
+            xalign=0,
+            wrap=True,
+        )
+        licence.get_style_context().add_class("eduka-page-intro")
+        page.pack_start(licence, False, False, 0)
+        return page
+
+    # --------------------------------------------------------------- behaviour
+
+    def _show_page(self, page_id: str) -> None:
+        if self._stack.get_child_by_name(page_id) is None:
+            page_id = "home"
+        self._current_page = page_id
+        self._stack.set_visible_child_name(page_id)
+        for row in self._sidebar.get_children():
+            if getattr(row, "page_id", None) == page_id:
+                self._sidebar.select_row(row)
+
+    def _on_sidebar_row_selected(self, _listbox: Gtk.ListBox, row: Gtk.ListBoxRow | None) -> None:
+        if row is not None:
+            self._current_page = row.page_id  # type: ignore[attr-defined]
+            self._stack.set_visible_child_name(self._current_page)
+
+    def _on_key_press(self, _window: Gtk.Window, event: Gdk.EventKey) -> bool:
+        """Ctrl+Page Up/Down moves between pages; Ctrl+Q and Escape close."""
+
+        ctrl = bool(event.state & Gdk.ModifierType.CONTROL_MASK)
+        ids = [page_id for page_id, _icon, _title in PAGES]
+        if ctrl and event.keyval in (Gdk.KEY_Page_Down, Gdk.KEY_Page_Up):
+            index = ids.index(self._current_page)
+            index += 1 if event.keyval == Gdk.KEY_Page_Down else -1
+            self._show_page(ids[index % len(ids)])
+            return True
+        if (ctrl and event.keyval == Gdk.KEY_q) or event.keyval == Gdk.KEY_Escape:
+            self.close()
+            return True
+        return False
+
+    def _changed(self, name: str, value: Any) -> None:
+        """Saves a setting (debounced) and applies it to the running screen reader."""
+
+        if self._updating:
+            return
+        self._pending[name] = value
+        self._updating = True
+        try:
+            for show in self._views.get(name, []):
+                show(value)
+        finally:
+            self._updating = False
+        if name in ("large-text", "high-contrast"):
+            self._store.set(name, value)
+            self._apply_window_style()
+        if self._save_source:
+            GLib.source_remove(self._save_source)
+        self._save_source = GLib.timeout_add(SAVE_DELAY_MS, self._flush)
+
+    def _flush(self) -> bool:
+        self._save_source = 0
+        pending, self._pending = self._pending, {}
+        for name, value in pending.items():
+            self._store.set(name, value)
+            if name in backend.RESTART_REQUIRED and self._orca_running:
+                self._restart_needed = True
+            elif self._orca_running:
+                self._controller.apply(backend.SETTINGS[name], value)
+        self._store.sync()
+        self._update_infobar()
+        return GLib.SOURCE_REMOVE
+
+    def _update_infobar(self) -> None:
+        if self._restart_needed and self._orca_running:
+            self._infobar_label.set_label(_("Restart the screen reader to use the new settings."))
+            self._infobar.show()
+            self._infobar.get_content_area().show_all()
+        else:
+            self._infobar.hide()
+
+    def _on_infobar_response(self, _infobar: Gtk.InfoBar, response: int) -> None:
+        if response == Gtk.ResponseType.APPLY:
+            self._flush()
+            self._controller.restart()
+        self._restart_needed = False
+        self._update_infobar()
+
+    def _on_language_toggled(self, radio: Gtk.RadioButton, code: str) -> None:
+        if not radio.get_active() or self._updating:
+            return
+        self._store.set("language", code)
+        self._store.sync()
+        if self._orca_running:
+            self._restart_needed = True
+        i18n.set_language(code)
+        # Rebuild after the toggle handler returns; the radio button is destroyed.
+        GLib.idle_add(self._rebuild)
+
+    def _rebuild(self) -> bool:
+        self._build()
+        return GLib.SOURCE_REMOVE
+
+    def _apply_window_style(self) -> None:
+        style = self.get_style_context()
+        for name, css_class in (
+            ("large-text", "eduka-large-text"),
+            ("high-contrast", "eduka-high-contrast"),
+        ):
+            if self._store.get(name):
+                style.add_class(css_class)
+            else:
+                style.remove_class(css_class)
+
+    def _on_toggle_clicked(self, _button: Gtk.Button) -> None:
+        if self._orca_running:
+            self._controller.turn_off()
+        else:
+            self._flush()
+            if not self._controller.turn_on():
+                self._show_error(_("The screen reader could not be started."))
+
+    def _on_test_voice(self, _button: Gtk.Button) -> None:
+        self._flush()
+        sample = _("Hello! This is how Eduka-Orca sounds at this speed.")
+        if self._orca_running and self._controller.present_message(sample):
+            return
+        language = i18n.VOICE_LANGUAGES.get(i18n.current_language(), "en")
+        if not backend.speak_sample(
+            sample,
+            language,
+            int(self._store.get("rate")),
+            float(self._store.get("pitch")),
+            float(self._store.get("volume")),
+        ):
+            self._show_error(_("No speech is available. Please install speech-dispatcher."))
+
+    def _on_reset_voice(self, _button: Gtk.Button) -> None:
+        for name in ("rate", "pitch", "volume"):
+            self._store.reset(name)
+            if self._orca_running:
+                self._controller.apply(backend.SETTINGS[name], self._store.get(name))
+        self._store.sync()
+        self._build()
+
+    def _on_caption_preset(self, _button: Gtk.Button, foreground: str, background: str) -> None:
+        self._updating = True
+        self._fg_button.set_rgba(_rgba_from_hex(foreground))
+        self._bg_button.set_rgba(_rgba_from_hex(background))
+        self._updating = False
+        self._changed("captions-foreground", foreground)
+        self._changed("captions-background", background)
+        self._update_caption_preview()
+
+    def _on_caption_color(self, button: Gtk.ColorButton, name: str) -> None:
+        self._changed(name, _hex_from_rgba(button.get_rgba()))
+        self._update_caption_preview()
+
+    def _update_caption_preview(self) -> None:
+        def value(name: str) -> Any:
+            return self._pending.get(name, self._store.get(name))
+
+        css = (
+            f"label {{ font-size: {int(value('captions-font-size'))}pt; "
+            f"color: {value('captions-foreground')}; "
+            f"background-color: {value('captions-background')}; }}"
+        )
+        self._caption_css.load_from_data(css.encode())
+
+    def _on_reset_all(self, _button: Gtk.Button) -> None:
+        dialog = Gtk.MessageDialog(
+            transient_for=self,
+            modal=True,
+            message_type=Gtk.MessageType.QUESTION,
+            buttons=Gtk.ButtonsType.NONE,
+            text=_("Reset all settings?"),
+        )
+        dialog.format_secondary_text(_("All Eduka-Orca settings will go back to their defaults."))
+        dialog.add_button(_("Cancel"), Gtk.ResponseType.CANCEL)
+        dialog.add_button(_("Reset"), Gtk.ResponseType.OK)
+        dialog.set_default_response(Gtk.ResponseType.CANCEL)
+        response = dialog.run()
+        dialog.destroy()
+        if response != Gtk.ResponseType.OK:
+            return
+        for name in backend.SETTINGS:
+            if name != "screen-reader-enabled":
+                self._store.reset(name)
+        self._store.sync()
+        i18n.set_language(str(self._store.get("language")))
+        if self._orca_running:
+            self._restart_needed = True
+        self._apply_window_style()
+        self._build()
+
+    def _show_error(self, text: str) -> None:
+        dialog = Gtk.MessageDialog(
+            transient_for=self,
+            modal=True,
+            message_type=Gtk.MessageType.ERROR,
+            buttons=Gtk.ButtonsType.CLOSE,
+            text=text,
+        )
+        dialog.run()
+        dialog.destroy()
+
+    def _refresh_status(self) -> None:
+        for update in self._status_widgets:
+            update()
+
+    def _on_orca_appeared(self, *_args: Any) -> None:
+        self._orca_running = True
+        self._refresh_status()
+        self._update_infobar()
+
+    def _on_orca_vanished(self, *_args: Any) -> None:
+        self._orca_running = False
+        self._restart_needed = False
+        self._refresh_status()
+        self._update_infobar()
+
+    def _on_destroy(self, _window: Gtk.Window) -> None:
+        if self._save_source:
+            GLib.source_remove(self._save_source)
+            self._flush()
+        Gio.bus_unwatch_name(self._watch_id)
+
+
+class SettingsApplication(Gtk.Application):
+    """Single-instance application: a second launch raises the existing window."""
+
+    def __init__(self) -> None:
+        super().__init__(
+            application_id=APPLICATION_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE
+        )
+        self._window: SettingsWindow | None = None
+        self._start_page = "home"
+        self.add_main_option(
+            "page",
+            ord("p"),
+            GLib.OptionFlags.NONE,
+            GLib.OptionArg.STRING,
+            "Page to open: home, language, speech, captions, reading, startup or about",
+            "PAGE",
+        )
+
+    def do_startup(self) -> None:  # pylint: disable=arguments-differ
+        Gtk.Application.do_startup(self)
+        provider = Gtk.CssProvider()
+        provider.load_from_data(CSS)
+        screen = Gdk.Screen.get_default()
+        if screen is not None:
+            Gtk.StyleContext.add_provider_for_screen(
+                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
+            )
+
+    def do_command_line(self, command_line: Gio.ApplicationCommandLine) -> int:
+        # pylint: disable=arguments-differ
+        options = command_line.get_options_dict().end().unpack()
+        if "page" in options:
+            self._start_page = options["page"]
+        self.activate()
+        return 0
+
+    def do_activate(self) -> None:  # pylint: disable=arguments-differ
+        if self._window is None:
+            store = backend.SettingsStore()
+            i18n.set_language(str(store.get("language")))
+            self._window = SettingsWindow(self, store, backend.OrcaController(), self._start_page)
+        else:
+            self._window._show_page(self._start_page)  # pylint: disable=protected-access
+        self._window.present()
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Runs Eduka-Orca Settings."""
+
+    return SettingsApplication().run(argv if argv is not None else sys.argv)
