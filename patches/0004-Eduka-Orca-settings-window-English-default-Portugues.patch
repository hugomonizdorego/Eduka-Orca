+    def _switch(self, name: str) -> Gtk.Switch:
+        switch = Gtk.Switch(active=bool(self._store.get(name)))
+        switch.connect("notify::active", lambda w, _p: self._changed(name, w.get_active()))
+        self._views.setdefault(name, []).append(lambda v: switch.set_active(bool(v)))
+        return switch
+
+    def _combo(self, name: str, options: tuple[tuple[str, str], ...]) -> Gtk.ComboBoxText:
+        combo = Gtk.ComboBoxText()
+        for value, label in options:
+            combo.append(value, _(label))
+        combo.set_active_id(str(self._store.get(name)))
+        combo.connect("changed", lambda w: self._changed(name, w.get_active_id()))
+        self._views.setdefault(name, []).append(lambda v: combo.set_active_id(str(v)))
+        return combo
+
+    def _scale(
+        self,
+        name: str,
+        lower: float,
+        upper: float,
+        step: float,
+        digits: int,
+        marks: tuple[tuple[float, str], ...] = (),
+    ) -> Gtk.Scale:
+        adjustment = Gtk.Adjustment(
+            value=float(self._store.get(name)),
+            lower=lower,
+            upper=upper,
+            step_increment=step,
+            page_increment=step * 10,
+        )
+        scale = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adjustment)
+        scale.set_digits(digits)
+        scale.set_value_pos(Gtk.PositionType.RIGHT)
+        scale.set_hexpand(True)
+        scale.set_size_request(320, -1)
+        for value, label in marks:
+            scale.add_mark(value, Gtk.PositionType.BOTTOM, label)
+        scale.connect("value-changed", lambda w: self._changed(name, w.get_value()))
+        self._views.setdefault(name, []).append(lambda v: scale.set_value(float(v)))
+        return scale
+
