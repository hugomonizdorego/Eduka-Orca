+@pytest.mark.unit
+def test_store_round_trip(orca_schema: Path, tmp_path: Path):
+    """Values written by the window are read back from GSettings, and reset works."""
+
+    if shutil.which("glib-compile-schemas") is None:
+        pytest.skip("glib-compile-schemas is not installed")
+    shutil.copy(orca_schema, tmp_path)
+    shutil.copy(EDUKA_SCHEMA_XML, tmp_path)
+    subprocess.run(["glib-compile-schemas", "--strict", str(tmp_path)], check=True)
+
+    code = f"""
+import sys
+sys.path.insert(0, {str(EDUKA / "settings")!r})
+from eduka_orca_settings import backend
+store = backend.SettingsStore()
+assert not store.missing_schemas - {{backend.A11Y_SCHEMA}}, store.missing_schemas
+assert store.get("rate") == 30 and store.get("language") == "en"
+store.set("rate", 41.6)
+store.set("language", "tet")
+store.set("punctuation-level", "some")
+store.set("captions-font-size", 32.0)
+assert store.get("rate") == 42, store.get("rate")
+assert store.get("language") == "tet"
+assert store.get("punctuation-level") == "some"
+assert store.get("captions-font-size") == 32
+store.reset("rate")
+assert store.get("rate") == 30
+"""
+    env = dict(os.environ, GSETTINGS_SCHEMA_DIR=str(tmp_path), GSETTINGS_BACKEND="memory")
+    subprocess.run([sys.executable, "-c", code], check=True, env=env)
